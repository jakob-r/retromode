    "db:seed-demo": "tsx src/db/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fractional-indexing": "^4.0.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@retromode/shared": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
